{
    "exclude": ["vendor"],
    "preset": "laravel",
    "rules": {
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "method_public",
                "method_protected",
                "method_private"
            ],
            "sort_algorithm": "none"
        }
    }
}
