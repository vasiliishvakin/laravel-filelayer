{
    "name": "vaskiq/laravel-filelayer",
    "description": "A flexible and extensible file handling, storage management, and file processing package for Laravel applications.",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Vaskiq\\LaravelFileLayer\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "require": {
        "php": "^8.3",
        "intervention/image": "^3.9",
        "spatie/laravel-image-optimizer": "^1.8",
        "vaskiq/laravel-datalayer": "^0.2-dev",
        "symfony/filesystem": "^7.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/filesystem": "^11.0 || ^12.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.5 || ^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaskiq\\LaravelFileLayer\\Providers\\LaravelFileLayerServiceProvider"
            ]
        }
    }
}
